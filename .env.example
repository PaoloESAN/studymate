# .env.example - Plantilla de variables de entorno para StudyMate
# Conexión a PostgreSQL en Supabase con PgBouncer (puerto 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Autenticación y URL de despliegue
NEXTAUTH_SECRET="studymate-secret-key-2026"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
